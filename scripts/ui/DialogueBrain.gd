class_name DialogueBrain
extends RefCounted
## Offline character "AI" for verbal interaction. No network and no model: a persona and memory
## driven response generator. It mixes the speaker's faction and role, their relationship with
## Sakib, what they have seen him do, the hour, Heat, ghosts, the current objective (with real
## compass directions and distance) and the satire bank. Answers stay in Bengali.

const COMPASS := ["উত্তর", "উত্তর-পূর্ব", "পূর্ব", "দক্ষিণ-পূর্ব", "দক্ষিণ", "দক্ষিণ-পশ্চিম", "পশ্চিম", "উত্তর-পশ্চিম"]

static func _pick(arr: Array) -> String:
	return str(arr[randi() % arr.size()])

static func direction(from: Vector3, to: Vector3) -> String:
	var d := to - from
	d.y = 0.0
	var ang := atan2(d.x, -d.z)            # 0 = north (-Z), clockwise
	var idx := int(round(fposmod(ang, TAU) / (TAU / 8.0))) % 8
	return "%s দিকে, প্রায় %s মিটার" % [COMPASS[idx], BnText.num(int(round(d.length() / 10.0) * 10))]

static func respond(s: Services, a: Actor, intent: String, m: Dictionary) -> String:
	var rel := int(m.get("rel", 0))
	var night := s.clock.is_night()
	var stars := s.heat.stars if s.heat else 0
	var f := a.faction
	if rel <= -3 and intent != "bye":
		return _pick(["আপনার সাথে কথা নেই।", "যান তো, মেজাজ খারাপ।", "আপনার মতো উকিলের জন্যই মামলা লম্বা হয়।"])
	match intent:
		"greet":
			if f == "syndicate":
				return _pick(["কী চাই? এদিকে ঘোরাঘুরি ভালো না।", "উকিল সাহেব, রাস্তা মাপেন।", "আপনাকে তো চিনি... বসের খাতায় আপনার নাম আছে।"])
			if f == "pseudo":
				return _pick(["হ্যালো! আমার পেজে লাইক দিয়েছেন? ডায়েট চার্ট মাত্র ৫০০ টাকা।", "আমি সার্টিফায়েড! (সার্টিফিকেট কোথা থেকে, জিজ্ঞেস করবেন না।)"])
			if night:
				return _pick(["এত রাতে বাইরে? মোমবাতি আছে তো?", "সালাম। রাতে আলোর নিচে থাকবেন, ভাই।"])
			return _pick(["ওয়ালাইকুম সালাম! কী খবর?", "আরে সাকিব ভাই! ভাইভার খবর কী?", "ভালো আছি, দাম বাড়ছে, বেতন না।", "আসেন, আসেন। গরম চা চলবে?"])
		"news":
			var lines: Array = []
			if stars > 0:
				lines.append("সিন্ডিকেটের ছেলেরা আপনাকে খুঁজছে, %s তারকা গরম।" % BnText.num(stars))
			var gh := s.save.ghosts().size()
			if gh > 0:
				lines.append("শুনেছি রাতে %sটা প্রশ্নভূত ঘোরে। একটা তো চায়ের দোকানের পাশে দাঁড়িয়ে ১৯৭১ সালের প্রশ্ন করছিল।" % BnText.num(gh))
			if s.missions:
				var obj := str(s.missions.call("objective_text"))
				if obj != "":
					lines.append("আপনার কাজটা? '%s'... সাবধানে।" % obj)
			lines.append(s.taunts.pick("civilian"))
			if f == "syndicate":
				return _pick(["খবর? খবর হলো আপনি বেশি নাক গলান।", "বসের খবর বসের কাছেই থাকে।"])
			return _pick(lines)
		"directions":
			if s.missions:
				var mp: Variant = s.missions.call("marker_pos")
				if mp != null:
					return "%s। %s" % [direction(a.global_position, mp as Vector3), _pick(["রিকশা নিলে ভাড়া ষাট টাকা, হেঁটে গেলে ফ্রি।", "ফ্লাইওভারের নিচ দিয়ে যাবেন না, জ্যাম।", "ছাদে ছাদে গেলে তাড়াতাড়ি হবে।"])]
			return "এখন তো আপনার কোনো গন্তব্য দেখছি না। চায়ের দোকানে বসেন।"
		"homeco":
			match f:
				"pseudo":
					return _pick(["আমরা নিউট্রিশনিস্ট! ফেসবুকে লেখা আছে, মানে সত্য!", "সার্টিফিকেটে 'Home Economics' লেখা, কিন্তু হৃদয়ে 'Clinical'।"])
				"syndicate":
					return _pick(["পদবি বেচা আমাদের সাইড বিজনেস। ক্লিনিক্যাল সার্টিফিকেট সাত দিনে, ডেলিভারি ফ্রি।", "ছাত্রীরা যত ভুয়া পদবি লেখে, আমাদের কোর্স তত চলে।"])
				"patient":
					return _pick(["পুষ্টি-ডেস্কের আপা বলেছিল ইনসুলিন লাগবে না। এখন আমি হাসপাতালে।", "যে চিকিৎসা দেয়, তার নিবন্ধন আছে কিনা, এখন থেকে জিজ্ঞেস করব।"])
				"student":
					return _pick(["আমরা প্রতারিত হয়েছি। পড়েছি গার্হস্থ্য অর্থনীতি, পদবি বেচেছে কোচিংওয়ালা।", "বিষয়টা লজ্জার না। লজ্জা হলো অন্য পেশার নাম চুরি করা।"])
			if rel >= 2:
				return "সত্যি বলি? বিষয়টা খারাপ না: শিশু বিকাশ, সম্পদ ব্যবস্থাপনা, বস্ত্রবিজ্ঞান। কিন্তু রোগীর চিকিৎসার জন্য আলাদা প্রশিক্ষণ, ইন্টার্নশিপ আর নিবন্ধন লাগে। সেটা ছাড়া 'ক্লিনিক্যাল' লেখা প্রতারণা।"
			return s.taunts.pick("homeco")
		"syndicate":
			if f == "syndicate":
				return _pick(["কোন সিন্ডিকেট? আমি তো কোচিং টিচার।", "বেশি জানলে রাতে প্রশ্নভূত হবেন।"])
			if a.informant:
				return "আস্তে বলেন! আমি ওদের হয়ে খবর দিই... কিন্তু আপনাকে বলি: 'ম' জলছাপওয়ালা কাগজ যেখানে, সেখানেই ওরা।"
			return _pick(["কোচিংয়ের ব্যানারের নিচে ছোট করে কোড লেখা থাকে। ওগুলো পড়েন।", "শুনেছি প্রশ্ন আসে সদরঘাট দিয়ে, টাকা যায় গুলশানে।", "মহাপরীক্ষক কে, কেউ জানে না। শুধু জানি, সে সবার চেয়ে বেশি প্রশ্ন জানে আর কম উত্তর দেয়।"])
		"job":
			return _pick(["চাকরি? তিন বছর ধরে 'পদ শূন্য নেই' শুনছি। পদ আছে, শূন্য শুধু আমরা।", "বিসিএসের বয়সসীমা আর আমার ধৈর্য একসাথে শেষ হচ্ছে।", "চাকরির আবেদন ফি দিতে দিতে একটা দোকান দেওয়া যেত।"])
		"insult":
			if f == "syndicate":
				return "মুখ সামলান, নইলে মুখের মাপে প্রশ্ন দেব।"
			return _pick(["উকিল হয়ে এমন ভাষা? বার কাউন্সিলে অভিযোগ দেব।", "আপনার কথায় দুঃখ পেলাম। পাস করা সার্টিফিকেটের মতো নরম মন আমার।"])
		"praise":
			return _pick(["ধন্যবাদ! আপনার মতো ভদ্র লোক এখন কম।", "আল্লাহ আপনার ভাইভা সহজ করুক।", "আপনি চাকরি পেলে মিষ্টি খাওয়াবেন।"])
		"threat":
			if f == "syndicate":
				return "হুমকি? চলেন, দেখি কার হাত শক্ত!"
			return _pick(["বাঁচাও! উকিল মারছে!", "পুলিশ! পুলিশ!"])
		"bribe":
			if f == "police":
				return "ঘুষ? ইন্সপেক্টর মাহফুজের লোক আমি। টাকা ফেরত নিন, নইলে মামলা।"
			if rel >= 0 and (a.informant or f == "syndicate"):
				return "টাকা পেলাম... শুনুন, আজ রাতে গোডাউনে বান্ডিল নামবে। কাউকে বলবেন না কে বলেছে।"
			return _pick(["ঘুষ? এই শহরে সবাই খায়, কিন্তু আমি এখনো খাইনি।", "টাকা দিয়ে উত্তর কেনা যায় না, শুধু প্রশ্ন কেনা যায়।"])
		"ghost":
			return _pick(["রাতে বাইরে থাকলে মাথা ঘোরে, স্যানিটি কমে। আলোর নিচে থাকেন।", "প্রশ্নভূতের প্রশ্নের ঠিক উত্তর দিলে ও মুক্তি পায়। ভুল দিলে আরও রেগে যায়।", "ভোরের আলোয় ভূতেরা পুড়ে যায়। আমার নানি বলতেন, সূর্য হলো প্রকৃতির উত্তরপত্র।"])
		"law":
			return _pick(["আইনের কথা আপনিই ভালো জানেন। আমি জানি শুধু ভাড়ার আইন: মাসের ৫ তারিখ।", "দণ্ডবিধি ৪২০ শুনলেই সবাই চুপ হয়ে যায়।", "আদালতে গেলে তারিখ পড়ে, রায় পড়ে না।"])
		"joke":
			return _pick(["এক ছেলে বিসিএস দিয়ে বলল 'আমি ক্যাডার হব'। ২০ বছর পর সে এখন কোচিংয়ের ক্যাডার।",
				"নিউট্রিশনিস্ট আপা বললেন, 'চিনি বাদ দিন।' রোগী বলল, 'চাকরিও তো বাদ, এবার কী খাব?'",
				"সিলেবাস এত পুরোনো যে প্রশ্নে লেখা 'টেলিগ্রাম পাঠানোর নিয়ম লেখ'।"])
		"bye":
			return _pick(["খোদা হাফেজ। ছায়ায় ছায়ায় যাবেন।", "আসেন, আবার দেখা হবে। পরীক্ষার হলে না হলেই ভালো।", "বিদায়। রাতে মোমবাতি জ্বালাবেন।"])
	return _pick(["বুঝলাম না, আবার বলেন?", "এটা কি বিসিএসের প্রশ্ন? আমার সিলেবাসে নেই।", "হুম... কথাটা ভাবার মতো। তবে চা ঠান্ডা হয়ে যাচ্ছে।", "আপনার কথা শুনে মনে হলো ভাইভা বোর্ডে বসে আছি।"])

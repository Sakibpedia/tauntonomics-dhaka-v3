class_name EventBus
extends Node
## Game-wide signals. Systems talk through the bus instead of holding references to each other.

signal toast(text: String, kind: String)
signal subtitle(speaker: String, text: String, seconds: float)
signal answer_given(correct: bool, cat: String, context: String)
signal exam_finished(context: String, passed: bool, correct: int, total: int)
signal actor_downed(actor: Node)
signal actor_died(actor: Node, by_player: bool)
signal actor_arrested(actor: Node)
signal ghost_spawned(ghost: Node)
signal ghost_banished(ghost: Node)
signal item_collected(item: String, total: int)
signal poster_answered(kind: String, correct: bool)
signal mission_started(id: String, title: String)
signal mission_step(text: String)
signal mission_completed(id: String, reward: Dictionary)
signal mission_failed(reason: String)
signal level_started(n: int)
signal level_completed(n: int)
signal heat_changed(stars: int)
signal hour_changed(hour: int)
signal night_changed(is_night: bool)
signal player_damaged(amount: float, kind: String)
signal player_died(reason: String)
signal money_changed(total: int)
signal noise(pos: Vector3, radius: float, kind: String)
signal crime(pos: Vector3, severity: int)
signal debate_finished(id: String, won: bool)
signal talked(npc_id: String)
signal vehicle_entered(vehicle: Node)
signal vehicle_exited(vehicle: Node)

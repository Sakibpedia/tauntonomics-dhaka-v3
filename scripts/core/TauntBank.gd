var _bags: Dictionary = {}

func pick(group: String, vars: Dictionary = {}) -> String:
	var arr: Array = LINES.get(group, [])
	if arr.is_empty():
		return ""
	var bag: Array = _bags.get(group, [])
	if bag.is_empty():
		for i in arr.size():
			bag.append(i)
		bag.shuffle()
	var idx := int(bag.pop_back())
	_bags[group] = bag
	return BnText.fmt(str(arr[idx]), vars)

func total() -> int:
	var n := 0
	for k in LINES.keys():
		n += (LINES[k] as Array).size()
	return n

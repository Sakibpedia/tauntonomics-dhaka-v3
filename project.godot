; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Taunt-o-Nomics: Dhaka"
config/description="ট্যান্ট-ও-নমিক্স: ঢাকা — নির্মাতা ও স্বত্বাধিকারী: এস এম নাজমুয সাকিব"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.03, 0.04, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://assets/logo/sakib_logo.png"
config/icon="res://assets/logo/sakib_logo.png"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/NotoSansBengali-Regular.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

gl_compatibility/fallback_to_angle=false
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=1
environment/ssao/quality=0
scaling_3d/scale=0.6
global_illumination/sdfgi/frames_to_converge=4
environment/defaults/default_clear_color=Color(0.62, 0.58, 0.52, 1)
mesh_lod/lod_change/threshold_pixels=1.5
environment/screen_space_reflection/roughness_quality=0
